// For format details, see https://aka.ms/devcontainer.json.
{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/refs/heads/main/schemas/devContainer.schema.json",
  "name": "dev",
  "build": {
    "dockerfile": "Containerfile"
  },
  "runArgs": ["--security-opt=label=disable", "--userns=keep-id"],
  "mounts": [
    "source=${localWorkspaceFolderBasename}-fish-cache,target=/home/dev/.local/share/fish,type=volume"
  ],
  "postCreateCommand": "mise install",
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "davidanson.vscode-markdownlint",
        "devmike.mikrotik-routeros-script",
        "donjayamanne.githistory",
        "editorconfig.editorconfig",
        "github.copilot",
        "github.copilot-chat",
        "github.vscode-github-actions",
        "github.vscode-pull-request-github",
        "mhutchie.git-graph",
        "ms-azuretools.vscode-docker",
        "ms-vsliveshare.vsliveshare",
        "openai.chatgpt",
        "ritwickdey.liveserver",
        "yzhang.markdown-all-in-one"
      ],
      "settings": {
        // editor fonts & ligatures
        "editor.fontFamily": "'Symbols Nerd Font Mono','Fira Code','Cascadia Code','JetBrains Mono','Droid Sans Mono','monospace',monospace",
        "editor.fontLigatures": true,

        // terminal fonts
        "terminal.integrated.fontFamily": "'Symbols Nerd Font Mono','Fira Code','Cascadia Code','JetBrains Mono','monospace'",

        // save behavior
        "files.autoSave": "afterDelay",
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true,
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.organizeImports": "explicit",
          "source.fixAll": "explicit"
        },

        // formatting / whitespace
        "editor.tabSize": 2,
        "editor.rulers": [
          { "column": 100, "color": "#80808022" },
          { "column": 120, "color": "#80808055" }
        ],
        "editor.renderWhitespace": "selection",
        "editor.formatOnPaste": true,
        "editor.linkedEditing": true,

        // git / scm
        "git.confirmSync": true,
        "git.autofetch": true,

        // copilot
        "github.copilot.nextEditSuggestions.enabled": true
      }
    }
  }
}
